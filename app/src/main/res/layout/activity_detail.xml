<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/surface"
        android:elevation="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="20dp">

        <ImageView
            android:id="@+id/btn_back"
            style="@style/IconCircle"
            android:background="@null"
            android:contentDescription="Go back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            style="@style/Text.LabelCaps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:letterSpacing="0.2"
            android:text="Car Details" />

        <ImageView
            android:id="@+id/btn_save"
            style="@style/IconCircle"
            android:contentDescription="Save to favourites" />

        <ImageView
            android:id="@+id/btn_chat"
            style="@style/IconCircle"
            android:layout_marginStart="6dp"
            android:contentDescription="Message seller"
            android:src="@drawable/ic_chat" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Commission pill -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:id="@+id/commission"
                    style="@style/Text.Kicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_green"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:textColor="@color/white" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/edition_tag"
                    style="@style/Text.LabelCaps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/secondary" />
            </LinearLayout>

            <!-- Hero stage -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="290dp"
                android:background="@color/surface_container">

                <ImageView
                    android:id="@+id/hero_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/year_badge"
                    style="@style/Text.LabelCaps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_pill_glass"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/primary" />

                <TextView
                    android:id="@+id/angle_hint"
                    style="@style/Text.Kicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="10dp"
                    android:text="Swipe to rotate"
                    android:textSize="10sp" />
            </FrameLayout>

            <!-- Angle picker -->
            <LinearLayout
                android:id="@+id/angle_pills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface_low"
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface_low"
                android:clipToPadding="false"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/thumbs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Identification & pricing -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/series"
                        style="@style/Text.Kicker"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/status"
                        style="@style/Text.LabelUi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_soft"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/title"
                        style="@style/Text.HeadlineLg"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/manrope_semibold" />

                    <TextView
                        android:id="@+id/edition"
                        style="@style/Text.LabelCaps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:fontFamily="@font/manrope_bold"
                        android:textColor="@color/primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.Kicker"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Price" />

                            <TextView
                                android:id="@+id/price"
                                style="@style/Text.MetricLarge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/manrope_semibold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/lease_block"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Text.Kicker"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Monthly From" />

                            <TextView
                                android:id="@+id/lease"
                                style="@style/Text.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/manrope_medium"
                                android:textColor="@color/primary"
                                android:textSize="18sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        style="@style/Text.BodySm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Price excludes registration and taxes. Monthly amount is an estimate." />
                </LinearLayout>
            </LinearLayout>

            <!-- Colour curation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface_low"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.HeadlineSm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Choose a Colour" />

                        <TextView
                            android:id="@+id/colour_name"
                            style="@style/Text.BodySm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <TextView
                        style="@style/Text.LabelCaps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 Colours"
                        android:textColor="@color/primary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/swatches"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/colour_desc"
                    style="@style/Text.BodySm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/on_surface_variant"
                    android:textStyle="italic" />
            </LinearLayout>

            <!-- Mechanical specifications -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="24dp"
                android:paddingEnd="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Kicker"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Specifications" />

                        <TextView
                            style="@style/Text.HeadlineSm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Performance &amp; Engine" />
                    </LinearLayout>

                    <TextView
                        style="@style/Text.LabelCaps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/secondary" />
                </LinearLayout>

                <GridLayout
                    android:id="@+id/spec_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-6dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="-6dp"
                    android:columnCount="2" />
            </LinearLayout>

            <!-- Torque curve -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_card"
                android:backgroundTint="@color/surface_low"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.LabelCaps"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Torque Curve" />

                    <TextView
                        android:id="@+id/torque_label"
                        style="@style/Text.Kicker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primary" />
                </LinearLayout>

                <com.gearshift.app.ui.TorqueCurveView
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginTop="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.Kicker.Small"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="1,500 RPM" />

                    <TextView
                        style="@style/Text.Kicker.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Peak 2,750–6,000 RPM" />

                    <TextView
                        style="@style/Text.Kicker.Small"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="7,000 RPM" />
                </LinearLayout>
            </LinearLayout>

            <!-- Dossier -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="24dp"
                android:paddingEnd="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.HeadlineSm"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Car History" />

                    <TextView
                        style="@style/Text.Kicker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Verified" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dossier"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_panel_container"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_primary"
                        android:contentDescription="@null"
                        android:padding="10dp"
                        android:src="@drawable/ic_verified"
                        app:tint="@color/white" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.LabelCaps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quality Checked" />

                        <TextView
                            style="@style/Text.BodySm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="This car was inspected and verified before being listed." />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Sticky concierge bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/btn_enquire"
            style="@style/Pill.Green"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:drawableStart="@drawable/ic_visibility"
            android:drawableTint="@color/white"
            android:letterSpacing="0.06"
            android:text="BOOK A TEST DRIVE" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_concierge_chat"
                style="@style/Pill.Soft"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_soft"
                android:drawableStart="@drawable/ic_chat"
                android:drawableTint="@color/primary"
                android:text="Message Seller" />

            <TextView
                android:id="@+id/btn_call"
                style="@style/Pill.Soft"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_call"
                android:drawableTint="@color/primary"
                android:text="Call Seller" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
