<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_dot_green" />

                <TextView
                    style="@style/Text.Kicker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Saved Cars"
                    android:textColor="@color/on_surface_variant" />

                <TextView
                    android:id="@+id/btn_share"
                    style="@style/Pill.Small.Soft"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_pill_low"
                    android:drawableStart="@drawable/ic_share"
                    android:drawableTint="@color/on_surface"
                    android:text="Share" />
            </LinearLayout>

            <TextView
                style="@style/Text.HeadlineLg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="My Favourites" />

            <TextView
                android:id="@+id/subtitle"
                style="@style/Text.BodySm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Telemetry contrast -->
        <LinearLayout
            android:id="@+id/compare_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_card"
            android:backgroundTint="@color/surface_low"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_circle_soft"
                    android:backgroundTint="@color/tertiary_container"
                    android:contentDescription="@null"
                    android:padding="7dp"
                    android:src="@drawable/ic_tune"
                    android:tint="@color/primary_fixed" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.LabelUi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope_semibold"
                        android:text="Compare Cars" />

                    <TextView
                        style="@style/Text.BodySm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="See specs side by side"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_compare"
                    style="@style/Pill.Small.Soft"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_pill_white"
                    android:drawableEnd="@drawable/ic_expand_more"
                    android:drawableTint="@color/on_surface" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/compare_drawer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/compare_columns"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/compare_delta"
                    style="@style/Text.BodySm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_panel_low"
                    android:backgroundTint="@color/surface"
                    android:padding="10dp"
                    android:textColor="@color/racing_green"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/shortlist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_card"
            android:backgroundTint="@color/surface_low"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="48dp"
            android:paddingEnd="24dp"
            android:paddingBottom="48dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_soft"
                android:backgroundTint="@color/surface_highest"
                android:contentDescription="@null"
                android:padding="15dp"
                android:src="@drawable/ic_favorite_border"
                android:tint="@color/secondary" />

            <TextView
                style="@style/Text.HeadlineSm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="No favourites yet" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Tap the heart on any car to save it here."
                android:textColor="@color/secondary" />

            <TextView
                android:id="@+id/btn_browse"
                style="@style/Pill.Green"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:text="Browse Cars" />
        </LinearLayout>

        <!-- Help card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_tertiary_container_card"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Kicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_glass_dark"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="Need Help?"
                    android:textColor="@color/primary_fixed"
                    android:textSize="10sp" />

                <TextView
                    style="@style/Text.BodySm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="We're here for you"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                style="@style/Text.HeadlineSm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Questions about a car?"
                android:textColor="@color/white" />

            <TextView
                style="@style/Text.BodySm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Our team can help with specs, prices and booking a test drive for any car you've saved."
                android:textColor="#CCFFFFFF" />

            <TextView
                android:id="@+id/btn_specialist"
                style="@style/Pill.Mint"
                android:layout_width="match_parent"
                android:layout_marginTop="16dp"
                android:drawableStart="@drawable/ic_concierge"
                android:drawableTint="@color/on_primary_fixed"
                android:text="Contact Us" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
