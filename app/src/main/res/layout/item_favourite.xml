<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp"
    android:background="@drawable/bg_card"
    android:clipToOutline="true"
    android:elevation="4dp"
    android:orientation="vertical"
    android:outlineProvider="background">

    <FrameLayout
        android:id="@+id/media"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:background="@color/surface_container"
        android:foreground="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/status"
                style="@style/Text.Kicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_green"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/specimen_no"
                style="@style/Text.LabelCaps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_glass"
                android:paddingStart="8dp"
                android:paddingTop="5dp"
                android:paddingEnd="8dp"
                android:paddingBottom="5dp"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/unsave"
            style="@style/IconCircle.Glass"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:contentDescription="Remove from shortlist"
            android:src="@drawable/ic_favorite"
            app:tint="@color/racing_green" />

        <TextView
            android:id="@+id/location"
            style="@style/Text.LabelCaps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="12dp"
            android:background="@drawable/bg_pill_glass_dark"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textColor="@color/inverse_on_surface"
            android:textSize="10sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/series"
                    style="@style/Text.Kicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/title"
                    style="@style/Text.HeadlineSm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Kicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Price"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/price"
                    style="@style/Text.HeadlineSm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/metrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_panel_low"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/option_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_primary"
                style="@style/Pill.Green"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_event"
                android:drawableTint="@color/white"
                android:text="Book a Test Drive" />

            <ImageView
                android:id="@+id/btn_delete"
                style="@style/IconCircle"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/surface_container"
                android:contentDescription="Remove from shortlist"
                android:src="@drawable/ic_delete"
                android:tint="@color/secondary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
