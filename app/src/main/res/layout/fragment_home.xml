<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/sections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 01 · Cinematic introduction -->
            <FrameLayout
                android:id="@+id/hero_section"
                android:layout_width="match_parent"
                android:layout_height="700dp">

                <com.gearshift.app.ui.cinema.HeroSlideshowView
                    android:id="@+id/hero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:id="@+id/hero_copy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="56dp">

                    <TextView
                        android:id="@+id/hero_kicker"
                        style="@style/Text.Kicker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0"
                        android:text="01  —  Aston Martin · India"
                        android:textColor="@color/media_accent" />

                    <TextView
                        android:id="@+id/hero_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:alpha="0"
                        android:fontFamily="@font/manrope_light"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.04"
                        android:lineSpacingMultiplier="0.95"
                        android:text="BEYOND THE\nORDINARY."
                        android:textColor="@color/white"
                        android:textSize="46sp" />

                    <TextView
                        android:id="@+id/hero_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:alpha="0"
                        android:fontFamily="@font/manrope_regular"
                        android:text="Discover the extraordinary world of Aston Martin."
                        android:textColor="@color/media_text_soft"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:id="@+id/hero_ctas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:alpha="0"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btn_hero_explore"
                            style="@style/Pill"
                            android:layout_width="wrap_content"
                            android:background="@drawable/bg_pill_gold"
                            android:drawableEnd="@drawable/ic_arrow_forward"
                            android:drawableTint="@color/on_highlight"
                            android:text="Explore Collection"
                            android:textColor="@color/on_highlight" />

                        <TextView
                            android:id="@+id/btn_hero_models"
                            style="@style/Pill"
                            android:layout_width="wrap_content"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_pill_ghost_dark"
                            android:text="Models" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/scroll_cue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="24dp"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Kicker.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scroll"
                        android:textColor="@color/media_text_soft" />

                    <View
                        android:id="@+id/scroll_line"
                        android:layout_width="1dp"
                        android:layout_height="22dp"
                        android:layout_marginTop="6dp"
                        android:background="@color/media_accent" />
                </LinearLayout>
            </FrameLayout>

            <!-- 02 · Latest model reveal: layered typography -->
            <FrameLayout
                android:id="@+id/reveal_section"
                android:layout_width="match_parent"
                android:layout_height="640dp"
                android:background="@drawable/glow_emerald"
                android:clipChildren="false">

                <TextView
                    style="@style/Text.Kicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="36dp"
                    android:text="02  —  The Latest"
                    android:textColor="@color/accent_text" />

                <TextView
                    android:id="@+id/reveal_word"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="80dp"
                    android:fontFamily="@font/manrope_bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.04"
                    android:maxLines="1"
                    android:text="DB12"
                    android:textColor="@color/text_primary"
                    android:textSize="168sp" />

                <View
                    android:id="@+id/reveal_shadow"
                    android:layout_width="300dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="420dp"
                    android:background="@drawable/car_shadow" />

                <ImageView
                    android:id="@+id/reveal_car"
                    android:layout_width="match_parent"
                    android:layout_height="270dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="180dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="Aston Martin DB12 front view"
                    android:scaleType="fitCenter"
                    android:src="@drawable/car_db12_front" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="40dp">

                    <TextView
                        android:id="@+id/reveal_kicker"
                        style="@style/Text.Kicker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="The New Super Tourer"
                        android:textColor="@color/accent_text" />

                    <TextView
                        android:id="@+id/reveal_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/manrope_light"
                        android:text="Aston Martin DB12"
                        android:textColor="@color/text_primary"
                        android:textSize="28sp" />

                    <TextView
                        android:id="@+id/reveal_specs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/manrope_medium"
                        android:letterSpacing="0.06"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/btn_reveal"
                        style="@style/Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_tag_gold"
                        android:drawableEnd="@drawable/ic_arrow_forward"
                        android:drawableTint="@color/highlight"
                        android:text="Discover DB12"
                        android:textColor="@color/highlight" />
                </LinearLayout>
            </FrameLayout>

            <!-- 03 · Performance chapter -->
            <FrameLayout
                android:id="@+id/perf_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg_subtle">

                <com.gearshift.app.ui.cinema.HudGridView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:id="@+id/perf_car"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.13"
                    android:contentDescription="@null"
                    android:rotation="90"
                    android:scaleType="fitCenter"
                    android:scaleX="1.6"
                    android:scaleY="1.6"
                    android:src="@drawable/car_vanquish_top" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="48dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="48dp">

                    <TextView
                        style="@style/Text.Kicker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="03  —  Performance"
                        android:textColor="@color/accent_text" />

                    <TextView
                        android:id="@+id/perf_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/manrope_light"
                        android:text="Engineered\nto thrill."
                        android:textColor="@color/text_primary"
                        android:textSize="38sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/manrope_medium"
                        android:letterSpacing="0.06"
                        android:text="VANQUISH  ·  5.2L TWIN-TURBO V12"
                        android:textColor="@color/accent_text"
                        android:textSize="12sp" />

                    <GridLayout
                        android:id="@+id/gauges"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:columnCount="2" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:fontFamily="@font/manrope_regular"
                        android:gravity="center"
                        android:text="The most powerful front-engined Aston Martin GT you can buy today."
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- 04 · Explore the collection -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="56dp">

                <TextView
                    style="@style/Text.Kicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:text="04  —  The Collection"
                    android:textColor="@color/accent_text" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="24dp"
                    android:fontFamily="@font/manrope_light"
                    android:text="Five ways to be\nextraordinary."
                    android:textColor="@color/text_primary"
                    android:textSize="34sp" />

                <LinearLayout
                    android:id="@+id/collection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipChildren="false"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 05 · Exclusive releases -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/glow_gold"
                android:orientation="vertical"
                android:paddingTop="40dp"
                android:paddingBottom="40dp">

                <TextView
                    style="@style/Text.Kicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:text="05  —  Exclusive Releases"
                    android:textColor="@color/accent_text" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/manrope_light"
                    android:text="Rare editions,\nnew arrivals &amp; stories."
                    android:textColor="@color/text_primary"
                    android:textSize="30sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:clipToPadding="false"
                    android:paddingStart="24dp"
                    android:paddingEnd="12dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/stories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="36dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/manrope_medium"
                        android:text="New Arrivals"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/btn_view_all"
                        style="@style/Text.Kicker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="6dp"
                        android:text="View all  →"
                        android:textColor="@color/accent_text" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/arrivals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp" />

                <!-- Sign-off -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <View
                        android:layout_width="40dp"
                        android:layout_height="1dp"
                        android:background="@color/highlight" />

                    <TextView
                        android:id="@+id/footer_mark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:fontFamily="@font/manrope_light"
                        android:letterSpacing="0.5"
                        android:text="GEARSHIFT"
                        android:textColor="@color/highlight_soft"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/manrope_regular"
                        android:text="Aston Martin Mumbai  ·  Aston Martin New Delhi"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btn_contact"
                        style="@style/Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_pill_outline_strong"
                        android:drawableStart="@drawable/ic_concierge"
                        android:drawableTint="@color/highlight"
                        android:text="Contact Us"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating header over the footage -->
    <LinearLayout
        android:id="@+id/home_header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/header_logo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="Gearshift logo"
            android:src="@drawable/ic_logo_media" />

        <TextView
            android:id="@+id/header_mark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="@font/manrope_semibold"
            android:letterSpacing="0.35"
            android:text="GEARSHIFT"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/btn_home_search"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Search"
            android:padding="9dp"
            android:src="@drawable/ic_search"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/btn_home_fav"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Favourites"
            android:padding="9dp"
            android:src="@drawable/ic_favorite_border"
            app:tint="@color/white" />
    </LinearLayout>
</FrameLayout>
